#, python-brace-format
msgid "Invitation: {role}"
msgstr "Pozvánka: {role}"

#: roles.py:445
msgid "The invitation can be valid for 12, 24, 36 or 48 hours."
msgstr "Pozvánka môže platiť 12, 24, 36 alebo 48 hodín."

#: roles.py:454
msgid "Select a department."
msgstr "Vyberte oddelenie."

#: roles.py:460
msgid "The end of the hand-over must be in the future."
msgstr "Koniec odovzdania musí byť v budúcnosti."

#: roles.py:463
msgid "There already is a temporary hand-over in this department."
msgstr "V tomto oddelení už prebieha dočasné odovzdanie."

#: roles.py:468
#, python-brace-format
msgid ""
"The department {department} has no head yet. Appoint the head first, then "
