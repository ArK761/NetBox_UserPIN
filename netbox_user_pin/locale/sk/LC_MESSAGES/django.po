msgid "End the hand-over now? The rights return at once."
msgstr "Ukončiť odovzdanie teraz? Práva sa hneď vrátia."

#: templates/netbox_user_pin/department.html:50
msgid "End hand-over"
msgstr "Ukončiť odovzdanie"

#: templates/netbox_user_pin/department.html:64
msgid ""
"A head is removed only together with a new head: the old head ends now, CORE"
" manages the department until the new head accepts."
msgstr ""
"Správcu možno odobrať iba spolu s určením nového: starý končí hneď, "
"oddelenie spravuje CORE, kým nový neprijme."

#: templates/netbox_user_pin/department.html:64
#, python-format
msgid ""
"At least %(min_delegates)s delegates must stay: then choose a replacement – "
"the current delegate stays until the replacement accepts."
msgstr ""
"Musia ostať aspoň %(min_delegates)s delegáti: vtedy vyberte náhradu – "
"súčasný delegát ostáva, kým náhrada neprijme."

#: templates/netbox_user_pin/department.html:69
msgid "No head and no delegates yet."
msgstr "Zatiaľ žiadny správca ani delegáti."

