msgid "The access was revoked."
msgstr "Prístup bol odvolaný."

#: guest_views.py:499
msgid "The access works again."
msgstr "Prístup opäť funguje."

#: guest_views.py:502
msgid "The access was deleted."
msgstr "Prístup bol zmazaný."

#: guest_views.py:506
msgid "You may not do this."
msgstr "Toto nesmieš urobiť."

#: guests.py:86
#, python-format
msgid ""
"The validity of your account ended on %(time)s. Contact the administrator."
msgstr "Platnosť tvojho účtu skončila %(time)s. Kontaktuj správcu."

#: guests.py:113
#, python-format
msgid "disabled since %(time)s"
msgstr "zakázaný od %(time)s"

#: guests.py:115
#, python-format
msgid "its validity ended on %(time)s"
msgstr "jeho platnosť skončila %(time)s"

#: guests.py:118
#, python-format
msgid "blocked after %(n)d wrong PINs"
msgstr "zablokovaný po %(n)d chybných PINoch"

#: guests.py:119
#, python-format
msgid "Request to unblock the PIN-only access %(id)s"
msgstr "Žiadosť o odblokovanie prístupu iba s PINom %(id)s"

#: guests.py:120
#, python-format
msgid ""
"%(name)s (%(id)s%(alias)s, %(email)s) asks to get the access back – %(state)s.\n"
"\n"
"Enable it or extend its validity here: %(link)s"
msgstr ""
"%(name)s (%(id)s%(alias)s, %(email)s) žiada o vrátenie prístupu – %(state)s.\n"
"\n"
"Povoľ ho alebo predĺž jeho platnosť tu: %(link)s"

#: guests.py:135 guests.py:567
msgid "The end of the access must be in the future."
msgstr "Koniec prístupu musí byť v budúcnosti."

#: guests.py:140
#, python-format
msgid "Your access is valid until %(time)s."
msgstr "Tvoj prístup platí do %(time)s."

#: guests.py:142
msgid "Your access is valid without a time limit."
msgstr "Tvoj prístup platí bez časového obmedzenia."

#: guests.py:156
#, python-format
msgid "Your NetBox access ends on %(time)s"
msgstr "Tvoj prístup do NetBoxu končí %(time)s"

#: guests.py:158
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"your access to NetBox ends on %(time)s. If you still need it, ask the administrator to extend it."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"tvoj prístup do NetBoxu končí %(time)s. Ak ho ešte potrebuješ, požiadaj správcu o predĺženie."

#: guests.py:173
#, python-format
msgid ""
"Your account is temporarily disabled by the administrator %(admin)s (since "
"%(time)s). Contact them."
msgstr ""
"Tvoj účet je dočasne zablokovaný – zakázal ho správca %(admin)s (od "
"%(time)s). Kontaktuj ho."

#: guests.py:216
msgid "Choose another PIN."
msgstr "Vyber iný PIN."

#: guests.py:223
#, python-format
msgid "The PIN must have %(min)d to %(max)d characters."
msgstr "PIN musí mať %(min)d až %(max)d znakov."

#: guests.py:226
msgid "This PIN is too easy to guess. Use at least four different characters."
msgstr "Tento PIN sa dá ľahko uhádnuť. Použi aspoň štyri rôzne znaky."

#: guests.py:238
#, python-format
msgid "\"%(value)s\" is not an IP address or a network."
msgstr "„%(value)s“ nie je IP adresa ani sieť."

#: guests.py:287
#, python-format
#| msgid "PIN-only access blocked: %(name)s"
msgid "PIN-only access %(id)s: %(what)s"
msgstr "Prístup len cez PIN %(id)s: %(what)s"

#: guests.py:288
#, python-format
msgid ""
"%(actor)s did this with the PIN-only access %(id)s (%(name)s, %(email)s):\n"
"\n"
"%(what)s%(detail)s"
msgstr ""
"%(actor)s urobil toto s prístupom len cez PIN %(id)s (%(name)s, %(email)s):\n"
"\n"
"%(what)s%(detail)s"

#: guests.py:325 guests.py:1147
msgid "Your NetBox access was changed"
msgstr "Tvoj prístup do NetBoxu bol zmenený"

#: guests.py:326 guests.py:1148
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"the administrator %(admin)s changed your access to NetBox:\n"
"\n"
"%(what)s"
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"administrátor %(admin)s zmenil tvoj prístup do NetBoxu:\n"
"\n"
"%(what)s"

#: guests.py:407
#, python-format
msgid "Language of the PIN pages and e-mails: %(pin)s; of NetBox: %(ui)s."
msgstr "Jazyk PIN stránok a e-mailov: %(pin)s; NetBoxu: %(ui)s."

#: guests.py:421
#, python-format
msgid "Name shown with your account: %(alias)s; description: %(description)s."
msgstr "Meno pri tvojom účte: %(alias)s; popis: %(description)s."

#: guests.py:439
msgid "Choose one of the offered intervals."
msgstr "Vyber jeden z ponúkaných intervalov."

#: guests.py:469
#| msgid "Choose a group of this object type."
msgid "Choose a country from the list."
msgstr "Vyber krajinu zo zoznamu."

#: guests.py:472
#| msgid "Choose at least one right."
msgid "Choose at least one working day."
msgstr "Vyber aspoň jeden pracovný deň."

#: guests.py:475
msgid "The working time must end after it starts (e.g. 06:00 to 16:00)."
msgstr "Pracovný čas musí končiť po svojom začiatku (napr. 06:00 až 16:00)."

#: guests.py:504
#, python-format
#| msgid "Rules for wrong PINs: %(rules)s."
msgid "Your working time: %(rules)s."
msgstr "Tvoj pracovný čas: %(rules)s."

#: guests.py:505
#| msgid "Your access is valid without a time limit."
msgid "Your access has no working-time limit."
msgstr "Tvoj prístup nemá obmedzený pracovný čas."

#: guests.py:513
#, python-format
msgid "%(user)s manages no section."
msgstr "%(user)s nespravuje žiadny úsek."

#: guests.py:520
#, python-format
#| msgid "PIN-only access: PIN set or changed"
msgid "PIN-only access %(id)s: manager changed"
msgstr "Prístup len cez PIN %(id)s: zmenený správca"

#: guests.py:521
#, python-format
msgid "The PIN-only access %(id)s (%(name)s) is now managed by %(who)s."
msgstr "Prístup len cez PIN %(id)s (%(name)s) teraz spravuje %(who)s."

#: guests.py:522
#| msgid "protection keepers"
msgid "the keepers"
msgstr "strážcovia ochrany"

#: guests.py:544
#| msgid "Choose a group of this object type."
msgid "Choose a group of your section."
msgstr "Vyber skupinu svojho úseku."

#: guests.py:548
msgid "Write the name of the person."
msgstr "Napíš meno osoby."

#: guests.py:552
msgid "Write a valid e-mail address."
msgstr "Napíš platnú e-mailovú adresu."

#: guests.py:554
msgid "An access with this e-mail address exists."
msgstr "Prístup s touto e-mailovou adresou už existuje."

#: guests.py:558
#, python-format
msgid ""
"The PIN-only access cannot be created. The address %(email)s already belongs"
" to the NetBox account %(user)s. This person signs in to NetBox with their "
"own account, so a PIN-only access is not needed: add the account to the "
"group as a regular user. If they really need a PIN-only access, first delete"
" the account %(user)s or change its e-mail to another address (Admin > Users"
" > %(user)s: %(url)s), then create the access again."
msgstr ""
"Prístup iba s PINom sa nedá vytvoriť. Adresa %(email)s už patrí účtu NetBoxu"
" %(user)s. Tento človek sa do NetBoxu prihlasuje vlastným účtom, takže "
"prístup iba s PINom nepotrebuje: pridaj ho do skupiny ako bežného "
"používateľa. Ak naozaj potrebuje prístup iba s PINom, najprv zmaž účet "
"%(user)s alebo mu zmeň e-mail na inú adresu (Admin > Používatelia > "
"%(user)s: %(url)s) a potom vytvor prístup znova."

#: guests.py:565
msgid "Choose a group."
msgstr "Vyber skupinu."

#: guests.py:570
msgid "Idle time is 5 to 240 minutes, the whole session 1 to 24 hours."
msgstr "Nečinnosť je 5 až 240 minút, celá relácia 1 až 24 hodín."

#: guests.py:614
msgid "Your access to NetBox"
msgstr "Tvoj prístup do NetBoxu"

#: guests.py:615
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"you were given access to NetBox through a PIN.\n"
"\n"
"Your personal link:\n"
"%(link)s\n"
"\n"
"%(first)s\n"
"Keep the link to yourself: it works only together with your PIN."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"dostal si prístup do NetBoxu cez PIN.\n"
"\n"
"Tvoj osobný odkaz:\n"
"%(link)s\n"
"\n"
"%(first)s\n"
"Odkaz nikomu nedávaj: funguje len spolu s tvojím PIN-om."

#: guests.py:618
#, python-format
msgid "Open it and choose your own PIN within %(days)d days."
msgstr "Otvor ho a do %(days)d dní si vyber vlastný PIN."

#: guests.py:619
msgid "Open it and enter your PIN."
msgstr "Otvor ho a zadaj svoj PIN."

#: guests.py:620
#, python-format
msgid ""
"Afterwards save this page and sign in there with your PIN only: %(page)s"
msgstr "Potom si tú stránku ulož a prihlasuj sa tam už len PIN-om: %(page)s"

#: guests.py:631
msgid "Write the waits as whole seconds separated by commas, e.g. 10,20,30."
msgstr "Čakania napíš v celých sekundách oddelených čiarkou, napr. 10,20,30."

#: guests.py:633
msgid "1 to 10 waits, each 1 to 3600 seconds."
msgstr "1 až 10 čakaní, každé 1 až 3600 sekúnd."

#: guests.py:651
#, python-format
msgid "%(n)d wrong PINs, wait %(waits)s s; then blocked"
msgstr "%(n)d chybných PINov → čakanie %(waits)s s; potom blokovanie"

#: guests.py:660
msgid "Wrong PINs per step: 1 to 50."
msgstr "Chybných PINov na krok: 1 až 50."

#: guests.py:673
#, python-format
msgid "Rules for wrong PINs: %(rules)s."
msgstr "Pravidlá pre zlý PIN: %(rules)s."

#: guests.py:683 guests.py:872
msgid "Your NetBox access works again"
msgstr "Tvoj prístup do NetBoxu opäť funguje"

#: guests.py:684
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"the administrator unblocked your access. You can sign in with your PIN again."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"správca odblokoval tvoj prístup. Môžeš sa znova prihlásiť svojím PINom."

#: guests.py:695
msgid "You must change your PIN"
msgstr "Musíš si zmeniť PIN"

#: guests.py:696
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"the administrator %(admin)s asked you to choose a new PIN. If you are signed in, you are asked for it right away; otherwise at your next sign-in."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"správca %(admin)s žiada, aby si si zvolil nový PIN. Ak si prihlásený, vyzve ťa hneď; inak pri najbližšom prihlásení."

#: guests.py:714
msgid "Your NetBox access is blocked"
msgstr "Tvoj prístup do NetBoxu je zablokovaný"

#: guests.py:715
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"after %(n)d wrong PINs your access was blocked. Ask the administrator to unblock it or to send you a link for a new PIN."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"po %(n)d chybných PINoch bol tvoj prístup zablokovaný. Požiadaj správcu, aby ho odblokoval alebo ti poslal odkaz na nový PIN."

#: guests.py:718
#, python-format
msgid "PIN-only access blocked: %(name)s"
msgstr "Prístup iba s PINom zablokovaný: %(name)s"

#: guests.py:719
#, python-format
msgid ""
"The PIN-only access of %(name)s (%(email)s) was blocked after %(n)d wrong "
"PINs. Unblock it or send a reset e-mail on the page People with a PIN only."
msgstr ""
"Prístup iba s PINom používateľa %(name)s (%(email)s) bol zablokovaný po "
"%(n)d chybných PINoch. Odblokuj ho alebo pošli resetovací e-mail na stránke "
"Ľudia len s PIN-om."

#: guests.py:755 service.py:293
msgid "The new PIN must differ from the current one."
msgstr "Nový PIN sa musí líšiť od súčasného."

#: guests.py:831
msgid "New PIN for your NetBox access"
msgstr "Nový PIN pre tvoj prístup do NetBoxu"

#: guests.py:832
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"you asked for a new PIN. Open this link and choose it (valid %(minutes)d minutes, once):\n"
"%(link)s\n"
"\n"
"If it was not you, ignore this message."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"požiadal si o nový PIN. Otvor tento odkaz a vyber si ho (platí %(minutes)d minút, jednorazovo):\n"
"%(link)s\n"
"\n"
"Ak si to nebol ty, správu ignoruj."

#: guests.py:857
msgid "Your NetBox access was disabled"
msgstr "Tvoj prístup do NetBoxu bol zakázaný"

#: guests.py:858
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"the administrator %(admin)s disabled your access to NetBox on %(time)s. Signing in with your PIN shows a page where you can ask the administrator to enable it again."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"administrátor %(admin)s ti %(time)s zakázal prístup do NetBoxu. Keď sa prihlásiš PIN-om, zobrazí sa stránka, kde môžeš administrátora požiadať o opätovné povolenie."

#: guests.py:873
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"the administrator enabled your access again. You can sign in with your PIN."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"správca ti znova povolil prístup. Môžeš sa prihlásiť svojím PINom."

#: guests.py:883
msgid "Your NetBox access was deleted"
msgstr "Tvoj prístup do NetBoxu bol zrušený"

#: guests.py:884
#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"the administrator %(admin)s deleted your access to NetBox. Your PIN does not work any more."
msgstr ""
"Ahoj %(name)s,\n"
"\n"
"administrátor %(admin)s zrušil tvoj prístup do NetBoxu. Tvoj PIN už nefunguje."

#: guests.py:1075
#, python-format
msgid "Wrong PINs from %(ip)s"
msgstr "Zlé PIN-y z adresy %(ip)s"

#: guests.py:1076
#, python-format
msgid "%(n)d wrong PINs on the PIN-only page from the address %(ip)s."
msgstr "%(n)d zlých PIN-ov na stránke len s PIN-om z adresy %(ip)s."

#: guests.py:1119
#, python-format
msgid ""
"The address %(email)s is used by the PIN-only access %(id)s%(alias)s. Use "
"another address, or delete that PIN-only access first (User PIN > People "
"with a PIN only)."
msgstr ""
"Adresu %(email)s používa prístup iba s PINom %(id)s%(alias)s. Použi inú "
"adresu alebo najprv zmaž ten PIN prístup (User PIN > Ľudia len s PIN-om)."

#: guests.py:1140
#, python-format
msgid "You were added to the group %(group)s."
msgstr "Bol si pridaný do skupiny %(group)s."

#: guests.py:1143
#, python-format
msgid "You were removed from the group %(group)s."
msgstr "Bol si odobratý zo skupiny %(group)s."

#: guests.py:1170
msgid "added"
msgstr "pridaný"

#: guests.py:1172
msgid "deleted"
msgstr "zmazaný"

#: guests.py:1187
#, python-format
msgid "%(field)s: from \"%(old)s\" to \"%(new)s\""
msgstr "%(field)s: z „%(old)s“ na „%(new)s“"

#: guests.py:1199
#, python-format
msgid "%(id)s made a change"
msgstr "%(id)s urobil zmenu"

#: guests.py:1200
#, python-format
msgid "%(id)s made changes (%(n)d)"
msgstr "%(id)s urobil zmeny (%(n)d)"

#: models.py:41
msgid "One unlock for everything"
msgstr "Jedno odomknutie pre všetko"

#: models.py:42
msgid "Separate unlock per scope (plugin / area)"
msgstr "Samostatné odomknutie pre každú oblasť (plugin)"

#: models.py:46
msgid "All users may use a PIN (except denied users)"
msgstr "Všetci používatelia môžu mať PIN (okrem zakázaných)"

#: models.py:47
msgid "Only explicitly allowed users may use a PIN"
msgstr "PIN môžu mať iba výslovne povolení používatelia"

#: models.py:51
msgid "Default"
msgstr "Predvolené"

#: models.py:52 templates/netbox_user_pin/inc/group_filter.html:14
msgid "Allowed"
msgstr "Povolené"

#: models.py:53 models.py:955
#: templates/netbox_user_pin/inc/group_filter.html:23
msgid "Denied"
msgstr "Zakázané"

#: models.py:61
msgid "Language"
msgstr "Jazyk"

#: models.py:65
msgid "Language of the User PIN pages and e-mails."
msgstr "Jazyk stránok a e-mailov User PIN."

#: models.py:68
msgid "Show first and last name"
msgstr "Zobrazovať meno a priezvisko"

#: models.py:70
msgid ""
"Show the users' first and last name next to the username (Users, Delegates, "
"e-mail recipients)."
msgstr ""
"Zobrazovať meno a priezvisko používateľov vedľa používateľského mena "
"(Používatelia, Delegáti, príjemcovia e-mailu)."

#: models.py:73
msgid "Who may use a PIN"
msgstr "Kto môže mať PIN"

#: models.py:77
msgid ""
"Per-user Allow / Deny is set on the Users page. Superusers are always "
"allowed."
msgstr ""
"Povolenie / zákaz pre jednotlivcov sa nastavuje na stránke Používatelia. "
"Superpoužívatelia majú PIN povolený vždy."

#: models.py:80
msgid "PIN length"
msgstr "Dĺžka PINu"

#: models.py:83
msgid ""
"Number of digits (4-12). Existing PINs of another length stay valid until "
"changed."
msgstr "Počet číslic (4–12). Existujúce PINy inej dĺžky platia až do zmeny."

#: models.py:86
msgid "Unlock duration (minutes)"
msgstr "Doba odomknutia (minúty)"

#: models.py:91
msgid "Extend unlock on activity"
msgstr "Predlžovať odomknutie pri aktivite"

#: models.py:93
msgid ""
"Every protected page view restarts the unlock timer (i.e. it expires after "
"inactivity)."
msgstr ""
"Každé zobrazenie chránenej stránky reštartuje časovač (odomknutie vyprší po "
"nečinnosti)."

#: models.py:96
msgid "Unlock scope"
msgstr "Rozsah odomknutia"

#: models.py:102
msgid "Max failed attempts"
msgstr "Max. počet chybných pokusov"

#: models.py:107
msgid "Lockout duration (minutes)"
msgstr "Doba zablokovania (minúty)"

#: models.py:112
msgid "Block weak PINs"
msgstr "Blokovať slabé PINy"

#: models.py:114
msgid ""
"Reject repeated digits (111111), sequences (123456) and patterns (121212)."
msgstr ""
"Odmietnuť opakované číslice (111111), postupnosti (123456) a vzory (121212)."

#: models.py:117
msgid "Additional blocked PINs"
msgstr "Ďalšie zakázané PINy"

#: models.py:119
msgid "One per line or comma separated."
msgstr "Jeden na riadok alebo oddelené čiarkou."

#: models.py:122
msgid "PIN max age (days)"
msgstr "Platnosť PINu (dni)"

#: models.py:125
msgid ""
"Users must change their PIN after this many days (company policy). Note: "
"NIST SP 800-63B-4 does not recommend periodic changes, only forced changes "
"on suspected compromise."
msgstr ""
"Po tomto počte dní musia používatelia zmeniť PIN (firemná politika). "
"Poznámka: NIST SP 800-63B-4 neodporúča pravidelné zmeny, iba vynútenú zmenu "
"pri podozrení na kompromitáciu."

#: models.py:129
msgid "Warn before expiry (days)"
msgstr "Upozorniť pred vypršaním (dni)"

#: models.py:134
msgid "Require PIN + 2FA for administrative actions"
msgstr "Vyžadovať PIN + 2FA pri správcovských akciách"

#: models.py:136
msgid ""
"Allow / deny, reset, force change, settings and delegates need a fresh PIN +"
" 2FA confirmation (step-up). When off, the PIN alone is enough."
msgstr ""
"Povolenie / zákaz, reset, vynútená zmena, nastavenia a delegáti vyžadujú "
"čerstvé potvrdenie PIN + 2FA. Ak je vypnuté, stačí PIN."

#: models.py:140
msgid "Require 2FA also for settings"
msgstr "Vyžadovať 2FA aj pre nastavenia"

#: models.py:142
msgid ""
"Off: changes on the Settings and Mail pages and everyday actions (allow PIN,"
" moves between departments) need only your PIN (you are logged in anyway). "
"Resets, suspension and roles always need PIN + 2FA."
msgstr ""
"Vypnuté: zmeny v Nastaveniach a Maile a bežné úkony (povolenie PINu, presuny"
" medzi oddeleniami) stačí potvrdiť PINom (prihlásený ste aj tak). Resety, "
"pozastavenie a roly vždy vyžadujú PIN + 2FA."

#: models.py:147
msgid "2FA asked again after (hours)"
msgstr "2FA sa znova pýta po (hodinách)"

#: models.py:150
msgid ""
"Administration of the protected areas needs the unlocked PIN and a 2FA code "
"confirmed within this time; the PIN is not asked again for every change."
msgstr ""
"Správa chránených oblastí vyžaduje odomknutý PIN a 2FA kód potvrdený v tomto"
" čase; PIN sa nepýta pri každej zmene."

#: models.py:154
msgid "Administrative window (minutes)"
msgstr "Admin okno (minúty)"

#: models.py:157
msgid "How long a step-up confirmation stays valid."
msgstr "Ako dlho platí potvrdenie totožnosti."

#: models.py:160
msgid "Require 2FA on every unlock"
msgstr "Vyžadovať 2FA pri každom odomknutí"

#: models.py:164
msgid "Self-service recovery of a forgotten PIN"
msgstr "Samoobslužná obnova zabudnutého PINu"

#: models.py:166
msgid "A code sent by e-mail AND a 2FA code are required together."
msgstr "Vyžaduje sa kód z e-mailu A zároveň 2FA kód."

#: models.py:169
msgid "Recovery code validity (minutes)"
msgstr "Platnosť kódu na obnovu (minúty)"

#: models.py:174 templates/netbox_user_pin/mail.html:63
msgid "Allowed e-mail domains"
msgstr "Povolené e-mailové domény"

#: models.py:176
msgid ""
"E-mails are only sent to these domains, one per line (e.g. firma.sk). Empty "
"= no e-mails."
msgstr ""
"E-maily sa posielajú iba na tieto domény, jedna na riadok (napr. firma.sk). "
"Prázdne = žiadne e-maily."

#: models.py:179
msgid "Administrator reset valid (hours)"
msgstr "Platnosť resetu od administrátora (hodiny)"

#: models.py:182
msgid "How long the user has to confirm a reset started by an administrator."
msgstr ""
"Koľko času má používateľ na potvrdenie resetu, ktorý spustil administrátor."

#: models.py:185 templates/netbox_user_pin/settings.html:49
msgid "Four-eyes approval"
msgstr "Schvaľovanie štyrmi očami"

#: models.py:187
msgid ""
"Selected administrative changes need a second person who confirms with their"
" own PIN + 2FA. Turning it on needs at least two active CORE deputies. It "
"cannot be turned off while a department exists; turning it off needs two "
"people and ends the CORE delegation."
msgstr ""
"Vybrané správcovské zmeny musí potvrdiť druhá osoba vlastným PINom + 2FA. "
"Zapnutie vyžaduje aspoň dvoch aktívnych zástupcov CORE. Kým existuje "
"oddelenie, nedá sa vypnúť; vypnutie potvrdzujú dvaja a ukončí delegovanie "
"CORE."

#: models.py:191
msgid "… for roles (CORE, department heads and delegates)"
msgstr "… pre roly (CORE, správcovia a delegáti oddelení)"

#: models.py:193
msgid "… for settings and mail settings"
msgstr "… pre nastavenia a nastavenia mailu"

#: models.py:194
msgid "… for allowing / denying PIN use"
msgstr "… pre povolenie / zákaz PINu"

#: models.py:196
msgid "Deny everything not allowed"
msgstr "Zakázať všetko, čo nie je povolené"

#: models.py:198
msgid ""
"Everything that no protected area allows is denied to everybody except the "
"protection keepers. Needs at least one keeper (PIN + 2FA)."
msgstr ""
"Všetko, čo nepovoľuje žiadna chránená oblasť, je zakázané pre všetkých okrem"
" správcov ochrany. Vyžaduje aspoň jedného správcu (PIN + 2FA)."

#: models.py:203
msgid "A: shown, and blocked by the PIN notice"
msgstr "A: zobrazené a zablokované hláškou PIN"

#: models.py:204
msgid ""
"B: the user sees nothing he is not allowed (only the password and the PIN)"
msgstr "B: používateľ nevidí nič, čo nemá povolené (len heslo a PIN)"

#: models.py:205
msgid "The default for all protected areas; an area can choose its own."
msgstr ""
"Predvolené pre všetky chránené oblasti; oblasť si môže zvoliť vlastné."

#: models.py:208 templates/netbox_user_pin/areas.html:78
msgid "Users may ask for access"
msgstr "Používatelia smú žiadať o prístup"

#: models.py:209
msgid ""
"Off: nobody but the administrators can ask for access (there is no request "
"page or button)."
msgstr ""
"Vypnuté: o prístup nemôže žiadať nikto okrem správcov (nie je stránka ani "
"tlačidlo žiadosti)."

#: models.py:212
msgid "Whom the protection applies to"
msgstr "Na koho platí ochrana"

#: models.py:213
msgid "Everybody"
msgstr "Všetci"

#: models.py:213
msgid "Only people with a PIN"
msgstr "Len ľudia s PIN-om"

#: models.py:214
msgid ""
"Only people with a PIN: the PIN-only accesses and the users put into a group"
" or made owners of an area; everybody else works by the NetBox permissions "
"alone and does not see this plugin."
msgstr ""
"Len ľudia s PIN-om: prístupy len cez PIN a užívatelia vložení do skupiny "
"alebo vlastníci oblasti; ostatní pracujú len podľa práv NetBoxu."

#: models.py:218 templates/netbox_user_pin/areas.html:79
msgid "Users may create their own API key"
msgstr "Používatelia smú vytvoriť vlastný API kľúč"

#: models.py:219 templates/netbox_user_pin/areas.html:80
msgid ""
"A key works with the NetBox permissions of its user and the PIN does not "
"judge it: a superuser with a key reads everything through a script. Allow it"
" for users with narrow NetBox permissions."
msgstr ""
"Kľúč funguje s právami používateľa v NetBoxe a PIN ho neposudzuje: superuser"
" s kľúčom prečíta všetko cez skript. Povoľ ho používateľom s úzkymi právami "
"v NetBoxe."

#: models.py:223
msgid "Address of the PIN-only sign-in"
msgstr "Adresa prihlásenia len PIN-om"

#: models.py:224
msgid ""
"The one address where people with a PIN only sign in, e.g. /pin/, /tenanti/ "
"or /aqer/x2/."
msgstr ""
"Jediná adresa, kde sa ľudia len s PIN-om prihlasujú, napr. /pin/, /tenanti/ "
"alebo /aqer/x2/."

#: models.py:227 templates/netbox_user_pin/guest_list.html:100
#: templates/netbox_user_pin/guest_list.html:139
msgid "Wrong PINs per step"
msgstr "Chybných PINov na krok"

#: models.py:229
msgid ""
"PIN-only access: after this many wrong PINs the person must wait (see the "
"waits)."
msgstr ""
"Prístup iba s PINom: po toľkých chybných PINoch musí človek čakať (pozri "
"čakania)."

#: models.py:232 templates/netbox_user_pin/guest_list.html:140
msgid "Waits after each step (seconds)"
msgstr "Čakanie po každom kroku (sekundy)"

#: models.py:233
msgid ""
"E.g. 10,20,30: 5 wrong PINs, wait 10 s; 5 more, 20 s; 5 more, 30 s; the next"
" wrong PIN blocks the access until an administrator unblocks it or sends a "
"reset e-mail."
msgstr ""
"Napr. 10,20,30: 5 chybných PINov → čaká 10 s; ďalších 5 → 20 s; ďalších 5 → "
"30 s; ďalší chybný PIN prístup zablokuje, kým ho správca neodblokuje alebo "
"nepošle resetovací e-mail."

#: models.py:237
msgid "E-mail the person about changes of the access"
msgstr "Posielať človeku e-maily o zmenách prístupu"

#: models.py:238
msgid ""
"PIN-only access: every action of an administrator (groups, disable / enable,"
" PIN reset, validity ...) is e-mailed to the person. Can also be switched "
"off per access."
msgstr ""
"Prístup len cez PIN: každá akcia administrátora (skupiny, zakázanie / "
"povolenie, reset PIN, platnosť …) príde človeku e-mailom. Dá sa vypnúť aj "
"pre jednotlivý prístup."

#: models.py:242
msgid "E-mail the administrators what the person changed"
msgstr "Posielať administrátorom, čo človek zmenil"

#: models.py:243
msgid ""
"PIN-only access: once an hour a summary of what the person added, changed or"
" deleted goes to the administrator who created the access and to the "
"protection keepers. Can also be switched off per access."
msgstr ""
"Prístup len cez PIN: raz za hodinu príde súhrn toho, čo človek pridal, "
"zmenil alebo zmazal, administrátorovi, ktorý prístup vytvoril, a strážcom "
"ochrany. Dá sa vypnúť aj pre jednotlivý prístup."

#: models.py:248 templates/netbox_user_pin/guest_list.html:126
msgid "Limit the working time of the PIN-only accesses"
msgstr "Obmedziť pracovný čas prístupov len cez PIN"

