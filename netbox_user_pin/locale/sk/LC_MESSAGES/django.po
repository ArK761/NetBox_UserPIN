msgstr "Nesprávny PIN"

#: models.py:336
msgid "Locked out after failed attempts"
msgstr "Zablokovaný po chybných pokusoch"

#: models.py:337
msgid "Attempt while locked out"
msgstr "Pokus počas zablokovania"

#: models.py:338
msgid "Lockout cleared by administrator"
msgstr "Zablokovanie zrušil administrátor"

#: models.py:339
msgid "PIN change forced"
msgstr "Vynútená zmena PINu"

#: models.py:340
msgid "2FA enabled"
msgstr "2FA zapnuté"

#: models.py:341
msgid "2FA disabled"
msgstr "2FA vypnuté"

#: models.py:342
msgid "2FA reset by administrator"
msgstr "2FA resetované administrátorom"

#: models.py:343
msgid "Wrong 2FA code"
msgstr "Nesprávny 2FA kód"

#: models.py:344
msgid "Backup code used"
msgstr "Použitý záložný kód"

#: models.py:345
msgid "New backup codes generated"
msgstr "Vygenerované nové záložné kódy"

#: models.py:346
msgid "Administrative confirmation (step-up)"
msgstr "Potvrdenie totožnosti (admin)"

#: models.py:347
msgid "Administrative confirmation failed"
msgstr "Potvrdenie totožnosti zlyhalo"

#: models.py:348
msgid "Recovery code e-mailed"
msgstr "Kód na obnovu odoslaný e-mailom"

#: models.py:349
msgid "PIN recovered (e-mail + 2FA)"
msgstr "PIN obnovený (e-mail + 2FA)"

#: models.py:350
msgid "PIN recovery failed"
msgstr "Obnova PINu zlyhala"

#: models.py:351
msgid "E-mail sent"
msgstr "E-mail odoslaný"

#: models.py:352
msgid "E-mail failed"
msgstr "E-mail zlyhal"

#: models.py:353
msgid "Delegate added"
msgstr "Delegát pridaný"

#: models.py:354
msgid "Delegate removed"
msgstr "Delegát odobratý"

#: models.py:355
msgid "Delegate changed"
msgstr "Delegát zmenený"

#: models.py:356
msgid "Backup codes viewed"
msgstr "Záložné kódy zobrazené"

#: models.py:357
msgid "Verification code e-mailed"
msgstr "Overovací kód odoslaný e-mailom"

#: models.py:358
msgid "Four-eyes request created"
msgstr "Žiadosť na štyri oči vytvorená"

#: models.py:359
msgid "Four-eyes request confirmed"
msgstr "Žiadosť na štyri oči potvrdená"

#: models.py:360
msgid "Four-eyes request rejected"
msgstr "Žiadosť na štyri oči zamietnutá"

#: models.py:361
msgid "Four-eyes request cancelled"
msgstr "Žiadosť na štyri oči zrušená"

#: models.py:362
msgid "Four-eyes request executed"
msgstr "Žiadosť na štyri oči vykonaná"

#: models.py:363
msgid "Break-glass: executed alone by the master"
msgstr "Break-glass: master vykonal sám"

#: models.py:364
msgid "Allowed e-mail domain added"
msgstr "Povolená e-mailová doména pridaná"

#: models.py:365
msgid "Allowed e-mail domain verified"
msgstr "Povolená e-mailová doména overená"

#: models.py:366
msgid "Domain verification failed"
msgstr "Overenie domény zlyhalo"

#: models.py:367
msgid "Allowed e-mail domain removed"
msgstr "Povolená e-mailová doména odobratá"

#: models.py:368
msgid "PIN access changed by administrator"
msgstr "Povolenie PINu zmenil administrátor"

#: models.py:369
msgid "PIN suspended by administrator"
msgstr "PIN pozastavený administrátorom"

#: models.py:370
msgid "PIN suspension lifted by administrator"
msgstr "Pozastavenie PINu zrušil administrátor"

#: models.py:371
msgid "Reset started by administrator"
msgstr "Reset spustil administrátor"

#: models.py:372
msgid "Reset confirmed by the user"
msgstr "Reset potvrdil používateľ"

#: models.py:373
msgid "Reset cancelled"
msgstr "Reset zrušený"

#: models.py:374
msgid "Attempt by a user not allowed to use a PIN"
msgstr "Pokus používateľa bez povolenia PINu"

#: models.py:375
msgid "Locked manually"
msgstr "Uzamknuté ručne"

#: models.py:376
