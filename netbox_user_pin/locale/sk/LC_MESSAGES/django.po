#: approvals.py:101
#, python-brace-format
msgid "Four-eyes request #{pk}"
msgstr "Žiadosť na štyri oči #{pk}"

#: approvals.py:118
#, python-brace-format
msgid "{user} cannot confirm this request."
msgstr "{user} nemôže potvrdiť túto žiadosť."

#: approvals.py:121
msgid ""
"There is no other person with PIN and 2FA who could confirm (CORE, or the "
"head / delegates of the department)."
msgstr ""
"Nie je nikto ďalší s PINom a 2FA, kto by mohol potvrdiť (CORE, alebo "
"správca / delegáti oddelenia)."

#: approvals.py:130
#, python-brace-format
msgid ""
"{user} asks you to confirm: {summary}\n"
"\n"
"Open NetBox > User PIN > Approvals (#{pk}) and confirm with your PIN and 2FA "
"until {time}."
msgstr ""
"{user} vás žiada o potvrdenie: {summary}\n"
"\n"
"Otvorte NetBox > User PIN > Schvaľovanie (#{pk}) a potvrďte svojím PINom a "
"2FA do {time}."

#: approvals.py:142 roles.py:489 roles.py:603
msgid "PIN or 2FA code is not correct."
msgstr "PIN alebo 2FA kód nie je správny."

#: approvals.py:158
msgid ""
"You cannot confirm this request (already confirmed, expired or not "
"permitted)."
msgstr ""
"Túto žiadosť nemôžete potvrdiť (už potvrdená, vypršala alebo nemáte "
"oprávnenie)."

#: approvals.py:163
msgid "The request is no longer open."
msgstr "Žiadosť už nie je otvorená."

#: approvals.py:175
#, python-brace-format
msgid "{user} rejected: {summary}"
msgstr "{user} zamietol: {summary}"

#: approvals.py:186
msgid "You cannot cancel this request."
msgstr "Túto žiadosť nemôžete zrušiť."

#: approvals.py:196
msgid "Break-glass is not available."
msgstr "Núdzové vykonanie (break-glass) nie je dostupné."

#: approvals.py:198 roles.py:598
msgid "A reason is required."
msgstr "Dôvod je povinný."

#: approvals.py:209
#, python-brace-format
msgid ""
"BREAK-GLASS: {user} executed alone: {summary}\n"
"Reason: {reason}"
msgstr ""
"BREAK-GLASS: {user} vykonal sám: {summary}\n"
"Dôvod: {reason}"

#: forms.py:57 forms.py:310 templates/netbox_user_pin/inc/step_up_modal.html:13
msgid "2FA code"
msgstr "2FA kód"

#: forms.py:62 templates/netbox_user_pin/inc/step_up_modal.html:15
msgid "6 digits from your authenticator app, or a backup code."
msgstr "6 číslic z aplikácie Authenticator alebo záložný kód."

#: forms.py:71 service.py:1161
msgid "PIN"
msgstr "PIN"

#: forms.py:81 forms.py:235 forms.py:241 forms.py:276 forms.py:287 forms.py:308
#: templates/netbox_user_pin/inc/step_up_modal.html:10
msgid "Your PIN"
msgstr "Váš PIN"

#: forms.py:91
msgid "Code from the app"
msgstr "Kód z aplikácie"

#: forms.py:99 forms.py:228 forms.py:316
msgid "Code from the e-mail"
msgstr "Kód z e-mailu"

#: forms.py:104 forms.py:246 forms.py:273
msgid "New PIN"
msgstr "Nový PIN"

#: forms.py:105 forms.py:247 forms.py:274
msgid "Confirm new PIN"
msgstr "Potvrďte nový PIN"

#: forms.py:110 forms.py:252 forms.py:281
msgid "The PINs do not match."
msgstr "PINy sa nezhodujú."

#: forms.py:127
msgid "12 hours"
msgstr "12 hodín"

#: forms.py:127
msgid "24 hours"
msgstr "24 hodín"

#: forms.py:127
msgid "36 hours"
msgstr "36 hodín"

#: forms.py:127
msgid "48 hours"
msgstr "48 hodín"

#: forms.py:132 templates/netbox_user_pin/inc/hours_select.html:1
msgid "Invitation valid for"
msgstr "Platnosť pozvánky"

#: forms.py:134
msgid "The code in the e-mail must be used within this time."
msgstr "Kód z e-mailu treba použiť v tomto čase."

#: forms.py:140 forms.py:295 templates/netbox_user_pin/approval.html:11
#: templates/netbox_user_pin/invitation.html:11
msgid "Reason"
msgstr "Dôvod"

#: forms.py:151 forms.py:205 forms.py:214
#: templates/netbox_user_pin/department.html:78
#: templates/netbox_user_pin/department.html:104
#: templates/netbox_user_pin/departments.html:10
#: templates/netbox_user_pin/event_list.html:17
#: templates/netbox_user_pin/user_list.html:36
msgid "User"
msgstr "Používateľ"

#: forms.py:161 templates/netbox_user_pin/delegates.html:17
msgid "Can edit settings"
msgstr "Môže meniť nastavenia"

#: forms.py:171
msgid "Replacement"
msgstr "Náhrada"

#: forms.py:173
msgid "Needed when the minimum would not be met without it."
msgstr "Potrebná, ak by bez nej nebolo splnené minimum."

#: forms.py:183
msgid "Hand over to"
msgstr "Odovzdať komu"

#: forms.py:186
msgid "Until"
msgstr "Do"

#: forms.py:188
msgid "Then the rights return automatically."
msgstr "Potom sa práva automaticky vrátia."

#: forms.py:199 models.py:446
msgid "Name"
msgstr "Názov"

#: forms.py:200 models.py:447
msgid "Description"
msgstr "Popis"

#: forms.py:216
msgid "To the department"
msgstr "Do oddelenia"

#: forms.py:233
msgid "I understand the responsibility"
msgstr "Rozumiem zodpovednosti"

#: forms.py:257
msgid "Current PIN"
msgstr "Súčasný PIN"

#: forms.py:296
msgid "e.g. employee left"
msgstr "napr. zamestnanec odišiel"

#: forms.py:313
msgid "From your authenticator app – or leave empty and use the e-mail code."
msgstr ""
"Z aplikácie Authenticator – alebo nechajte prázdne a použite kód z e-mailu."

#: forms.py:323
msgid "Enter a 2FA code or the code from the e-mail."
msgstr "Zadajte 2FA kód alebo kód z e-mailu."

#: forms.py:330
msgid "Send test e-mail to"
msgstr "Poslať testovací e-mail na"

#: forms.py:332
msgid ""
"Users permitted to use a PIN with an e-mail address in an allowed domain."
msgstr "Používatelia s povoleným PINom a e-mailom v povolenej doméne."

#: forms.py:360
msgid "SMTP password"
msgstr "SMTP heslo"

#: forms.py:362
msgid ""
"Stored encrypted and never shown. Leave empty to keep the current password."
msgstr ""
"Uloží sa šifrovane a nikdy sa nezobrazí. Nechajte prázdne, ak chcete "
"ponechať súčasné heslo."

#: forms.py:375
msgid "A sender address is needed together with the SMTP server."
msgstr "K SMTP serveru je potrebná adresa odosielateľa."

#: forms.py:377
msgid "Enter the SMTP user."
msgstr "Zadajte SMTP používateľa."

#: forms.py:379
msgid "Enter the SMTP password."
msgstr "Zadajte SMTP heslo."

#: forms.py:384
msgid "Domain"
msgstr "Doména"

#: forms.py:412
msgid ""
"At least two active CORE deputies with PIN and 2FA are needed (User PIN > "
"CORE)."
msgstr ""
"Sú potrební aspoň dvaja aktívni zástupcovia CORE s PINom a 2FA (User PIN > "
"CORE)."

#: forms.py:417
msgid ""
"Four-eyes approval cannot be switched off while a department exists. "
"Dissolve the departments first."
msgstr ""
"Schvaľovanie štyrmi očami sa nedá vypnúť, kým existuje nejaké oddelenie. "
"Najprv oddelenia zrušte."

#: models.py:31
msgid "One unlock for everything"
msgstr "Jedno odomknutie pre všetko"

#: models.py:32
msgid "Separate unlock per scope (plugin / area)"
msgstr "Samostatné odomknutie pre každú oblasť (plugin)"

#: models.py:36
msgid "All users may use a PIN (except denied users)"
msgstr "Všetci používatelia môžu mať PIN (okrem zakázaných)"

#: models.py:37
msgid "Only explicitly allowed users may use a PIN"
msgstr "PIN môžu mať iba výslovne povolení používatelia"

#: models.py:41
msgid "Default"
msgstr "Predvolené"

#: models.py:42
msgid "Allowed"
msgstr "Povolené"

#: models.py:43
msgid "Denied"
msgstr "Zakázané"

#: models.py:51
msgid "Language"
msgstr "Jazyk"

#: models.py:55
msgid "Language of the User PIN pages and e-mails."
msgstr "Jazyk stránok a e-mailov User PIN."

#: models.py:58
msgid "Show first and last name"
msgstr "Zobrazovať meno a priezvisko"

#: models.py:60
msgid ""
"Show the users' first and last name next to the username (Users, Delegates, "
"e-mail recipients)."
msgstr ""
"Zobrazovať meno a priezvisko používateľov vedľa používateľského mena "
"(Používatelia, Delegáti, príjemcovia e-mailu)."

#: models.py:63
msgid "Who may use a PIN"
msgstr "Kto môže mať PIN"

#: models.py:67
msgid ""
"Per-user Allow / Deny is set on the Users page. Superusers are always "
"allowed."
msgstr ""
"Povolenie / zákaz pre jednotlivcov sa nastavuje na stránke Používatelia. "
"Superpoužívatelia majú PIN povolený vždy."

#: models.py:70
msgid "PIN length"
msgstr "Dĺžka PINu"

#: models.py:73
msgid ""
"Number of digits (4-12). Existing PINs of another length stay valid until "
"changed."
msgstr "Počet číslic (4–12). Existujúce PINy inej dĺžky platia až do zmeny."

#: models.py:76
msgid "Unlock duration (minutes)"
msgstr "Doba odomknutia (minúty)"

#: models.py:81
msgid "Extend unlock on activity"
msgstr "Predlžovať odomknutie pri aktivite"

#: models.py:83
msgid ""
"Every protected page view restarts the unlock timer (i.e. it expires after "
"inactivity)."
msgstr ""
"Každé zobrazenie chránenej stránky reštartuje časovač (odomknutie vyprší po "
"nečinnosti)."

#: models.py:86
msgid "Unlock scope"
msgstr "Rozsah odomknutia"

#: models.py:92
msgid "Max failed attempts"
msgstr "Max. počet chybných pokusov"

#: models.py:97
msgid "Lockout duration (minutes)"
msgstr "Doba zablokovania (minúty)"

#: models.py:102
msgid "Block weak PINs"
msgstr "Blokovať slabé PINy"

#: models.py:104
msgid ""
"Reject repeated digits (111111), sequences (123456) and patterns (121212)."
msgstr ""
"Odmietnuť opakované číslice (111111), postupnosti (123456) a vzory (121212)."

#: models.py:107
msgid "Additional blocked PINs"
msgstr "Ďalšie zakázané PINy"

#: models.py:109
msgid "One per line or comma separated."
msgstr "Jeden na riadok alebo oddelené čiarkou."

#: models.py:112
msgid "PIN max age (days)"
msgstr "Platnosť PINu (dni)"

#: models.py:115
msgid ""
"Users must change their PIN after this many days (company policy). Note: "
"NIST SP 800-63B-4 does not recommend periodic changes, only forced changes "
"on suspected compromise."
msgstr ""
"Po tomto počte dní musia používatelia zmeniť PIN (firemná politika). "
"Poznámka: NIST SP 800-63B-4 neodporúča pravidelné zmeny, iba vynútenú zmenu "
"pri podozrení na kompromitáciu."

#: models.py:119
msgid "Warn before expiry (days)"
msgstr "Upozorniť pred vypršaním (dni)"

#: models.py:124
msgid "Require PIN + 2FA for administrative actions"
msgstr "Vyžadovať PIN + 2FA pri správcovských akciách"

#: models.py:126
msgid ""
"Allow / deny, reset, force change, settings and delegates need a fresh PIN + "
"2FA confirmation (step-up). When off, the PIN alone is enough."
msgstr ""
"Povolenie / zákaz, reset, vynútená zmena, nastavenia a delegáti vyžadujú "
"čerstvé potvrdenie PIN + 2FA. Ak je vypnuté, stačí PIN."

#: models.py:130
msgid "Require 2FA also for settings"
msgstr "Vyžadovať 2FA aj pre nastavenia"

#: models.py:132
msgid ""
"Off: changes on the Settings and Mail pages need only your PIN (you are "
"logged in anyway). Actions on other users and delegates always need PIN + "
"2FA."
msgstr ""
"Vypnuté: zmeny na stránkach Nastavenia a Mail vyžadujú iba váš PIN "
"(prihlásený ste aj tak). Zásahy do iných používateľov a delegátov vždy "
"vyžadujú PIN + 2FA."

#: models.py:136
msgid "Administrative window (minutes)"
msgstr "Admin okno (minúty)"

#: models.py:139
msgid "How long a step-up confirmation stays valid."
msgstr "Ako dlho platí potvrdenie totožnosti."

#: models.py:142
msgid "Require 2FA on every unlock"
msgstr "Vyžadovať 2FA pri každom odomknutí"

#: models.py:146
msgid "Self-service recovery of a forgotten PIN"
msgstr "Samoobslužná obnova zabudnutého PINu"

#: models.py:148
msgid "A code sent by e-mail AND a 2FA code are required together."
msgstr "Vyžaduje sa kód z e-mailu A zároveň 2FA kód."

#: models.py:151
msgid "Recovery code validity (minutes)"
msgstr "Platnosť kódu na obnovu (minúty)"

#: models.py:156 templates/netbox_user_pin/mail.html:61
msgid "Allowed e-mail domains"
msgstr "Povolené e-mailové domény"

#: models.py:158
msgid ""
"E-mails are only sent to these domains, one per line (e.g. firma.sk). Empty "
"= no e-mails."
msgstr ""
"E-maily sa posielajú iba na tieto domény, jedna na riadok (napr. firma.sk). "
"Prázdne = žiadne e-maily."

#: models.py:161
msgid "Administrator reset valid (hours)"
msgstr "Platnosť resetu od administrátora (hodiny)"

#: models.py:164
msgid "How long the user has to confirm a reset started by an administrator."
msgstr ""
"Koľko času má používateľ na potvrdenie resetu, ktorý spustil administrátor."

#: models.py:167 templates/netbox_user_pin/settings.html:46
msgid "Four-eyes approval"
msgstr "Schvaľovanie štyrmi očami"

#: models.py:169
msgid ""
"Selected administrative changes need a second person who confirms with their "
"own PIN + 2FA. Turning it on needs at least two active CORE deputies. It "
"cannot be turned off while a department exists; turning it off needs two "
"people and ends the CORE delegation."
msgstr ""
"Vybrané správcovské zmeny musí potvrdiť druhá osoba vlastným PINom + 2FA. "
"Zapnutie vyžaduje aspoň dvoch aktívnych zástupcov CORE. Kým existuje "
"oddelenie, nedá sa vypnúť; vypnutie potvrdzujú dvaja a ukončí delegovanie "
"CORE."

#: models.py:173
msgid "… for roles (CORE, department heads and delegates)"
msgstr "… pre roly (CORE, správcovia a delegáti oddelení)"

#: models.py:175
msgid "… for settings and mail settings"
msgstr "… pre nastavenia a nastavenia mailu"

#: models.py:176
msgid "… for allowing / denying PIN use"
msgstr "… pre povolenie / zákaz PINu"

#: models.py:178
msgid "Approval request valid (minutes)"
msgstr "Platnosť žiadosti o schválenie (minúty)"

#: models.py:181
msgid ""
"Both can confirm live at the same time or the second one later, until the "
"request expires."
msgstr ""
"Obaja môžu potvrdiť naživo naraz alebo druhý neskôr, kým žiadosť nevyprší."

#: models.py:184
msgid "Allow break-glass for the master"
msgstr "Povoliť núdzové vykonanie (break-glass) pre mastera"

#: models.py:186
msgid ""
"In an emergency a superuser may execute a request alone with a reason; all "
"administrators and delegates are informed by e-mail."
msgstr ""
"V núdzi môže superpoužívateľ vykonať žiadosť sám s uvedením dôvodu; všetci "
"administrátori a delegáti dostanú e-mail."

#: models.py:189
msgid "Sender name"
msgstr "Meno odosielateľa"

#: models.py:190
msgid "e.g. NetBox PIN"
msgstr "napr. NetBox PIN"

#: models.py:192
msgid "Sender e-mail address"
msgstr "E-mailová adresa odosielateľa"

#: models.py:193
msgid ""
"e.g. netbox@firma.sk. Together with the SMTP server; if the server is empty, "
"the NetBox e-mail configuration (EMAIL in configuration.py) is used."
msgstr ""
"napr. netbox@firma.sk. Spolu so SMTP serverom; ak je server prázdny, použije "
"sa e-mailové nastavenie NetBoxu (EMAIL v configuration.py)."

#: models.py:197
msgid "SMTP server"
msgstr "SMTP server"

#: models.py:198
msgid "e.g. mail.firma.sk. Empty = use the NetBox e-mail configuration."
msgstr ""
"napr. mail.firma.sk. Prázdne = použije sa e-mailové nastavenie NetBoxu."

#: models.py:200
msgid "SMTP port"
msgstr "SMTP port"

#: models.py:202
msgid "SMTP timeout (s)"
msgstr "SMTP časový limit (s)"

#: models.py:205
msgid "Encryption"
msgstr "Šifrovanie"

#: models.py:206
msgid "Off (usually port 25)"
msgstr "Vypnuté (zvyčajne port 25)"

#: models.py:206
msgid "STARTTLS (usually port 587)"
msgstr "STARTTLS (zvyčajne port 587)"

#: models.py:207
msgid "SSL/TLS (usually port 465)"
msgstr "SSL/TLS (zvyčajne port 465)"

#: models.py:210
msgid "Automatic TLS"
msgstr "Automatické TLS"

#: models.py:211
msgid "With encryption off, STARTTLS is used when the server offers it."
msgstr "Pri vypnutom šifrovaní sa použije STARTTLS, ak ho server ponúka."

#: models.py:213
msgid "SMTP authentication"
msgstr "SMTP autentifikácia"

#: models.py:214
msgid "SMTP user"
msgstr "SMTP používateľ"

#: models.py:215
msgid "Service account the e-mails are sent from."
msgstr "Servisný účet, z ktorého sa posielajú e-maily."

#: models.py:218
msgid "Security notifications by e-mail"
msgstr "Bezpečnostné upozornenia e-mailom"

#: models.py:220
msgid "PIN set / changed / reset, lockout, upcoming expiry, 2FA changes."
msgstr ""
"Nastavenie / zmena / reset PINu, zablokovanie, blížiace sa vypršanie, zmeny "
"2FA."

#: models.py:224 models.py:225 models.py:228
#: templates/netbox_user_pin/settings.html:3
msgid "PIN settings"
msgstr "Nastavenia PINu"

#: models.py:298
msgid "user PIN"
msgstr "PIN používateľa"

#: models.py:299
msgid "user PINs"
msgstr "PINy používateľov"

