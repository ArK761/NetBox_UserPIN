#: approvals.py:101
#, python-brace-format
msgid "Four-eyes request #{pk}"
msgstr "Žiadosť na štyri oči #{pk}"

#: approvals.py:118
#, python-brace-format
msgid "{user} cannot confirm this request."
msgstr "{user} nemôže potvrdiť túto žiadosť."

#: approvals.py:121
msgid ""
"There is no other person with PIN and 2FA who could confirm (CORE, or the "
"head / delegates of the department)."
msgstr ""
"Nie je nikto ďalší s PINom a 2FA, kto by mohol potvrdiť (CORE, alebo správca"
" / delegáti oddelenia)."

#: approvals.py:130
#, python-brace-format
msgid ""
"{user} asks you to confirm: {summary}\n"
"\n"
"Open NetBox > User PIN > Approvals (#{pk}) and confirm with your PIN and 2FA until {time}."
msgstr ""
"{user} vás žiada o potvrdenie: {summary}\n"
"\n"
"Otvorte NetBox > User PIN > Schvaľovanie (#{pk}) a potvrďte svojím PINom a 2FA do {time}."

#: approvals.py:142 roles.py:516 roles.py:630
msgid "PIN or 2FA code is not correct."
msgstr "PIN alebo 2FA kód nie je správny."

#: approvals.py:158
msgid ""
"You cannot confirm this request (already confirmed, expired or not "
"permitted)."
msgstr ""
"Túto žiadosť nemôžete potvrdiť (už potvrdená, vypršala alebo nemáte "
"oprávnenie)."

#: approvals.py:163 approvals.py:209
msgid "The request is no longer open."
msgstr "Žiadosť už nie je otvorená."

#: approvals.py:182
#, python-brace-format
msgid "{user} rejected: {summary}"
msgstr "{user} zamietol: {summary}"

#: approvals.py:192
msgid "You cannot cancel this request."
msgstr "Túto žiadosť nemôžete zrušiť."

#: approvals.py:202
msgid "Break-glass is not available."
msgstr "Núdzové vykonanie (break-glass) nie je dostupné."

#: approvals.py:204 roles.py:625
msgid "A reason is required."
msgstr "Dôvod je povinný."

#: approvals.py:219
#, python-brace-format
msgid ""
"BREAK-GLASS: {user} executed alone: {summary}\n"
"Reason: {reason}"
msgstr ""
"BREAK-GLASS: {user} vykonal sám: {summary}\n"
"Dôvod: {reason}"

#: approvals.py:309
msgid "Four-eyes approval cannot be switched off while a department exists."
msgstr "Schvaľovanie štyrmi očami sa nedá vypnúť, kým existuje oddelenie."

#: approvals.py:313
msgid ""
"The protection cannot be switched off while areas with owners are active."
msgstr "Ochranu nemožno vypnúť, kým sú aktívne oblasti s vlastníkmi."

#: area_guard.py:201 templates/netbox_user_pin/area.html:71
msgid "individually"
msgstr "individuálne"

#: area_guard.py:221
#, python-format
msgid "Show %(blocked)s - the value of the field %(field)s of %(type)s"
msgstr "Zobraziť %(blocked)s – hodnotu poľa %(field)s v objekte %(type)s"

#: area_guard.py:397
#, python-format
msgid ""
"You have access to \"%(area)s\". To enter you need a PIN: set it here and "
"you will continue."
msgstr ""
"Máš prístup do „%(area)s“. Na vstup potrebuješ PIN: nastav si ho tu a budeš "
"pokračovať."

#: area_guard.py:585 navigation.py:13
#: templates/netbox_user_pin/my_access.html:4
msgid "My access"
msgstr "Môj prístup"

#: area_guard.py:586 templates/netbox_user_pin/guest_change.html:4
#: templates/netbox_user_pin/guest_home.html:29
msgid "Change my PIN"
msgstr "Zmeniť môj PIN"

#: area_guard.py:592 templates/netbox_user_pin/area_denied.html:46
msgid "Change the password"
msgstr "Zmeniť heslo"

#: area_guard.py:593 navigation.py:8 navigation.py:9
#: templates/netbox_user_pin/area_denied.html:47
#: templates/netbox_user_pin/my_pin.html:4
msgid "My PIN"
msgstr "Môj PIN"

#: area_guard.py:595 templates/netbox_user_pin/area_denied.html:48
msgid "My API keys"
msgstr "Moje API kľúče"

#: area_guard.py:628
msgid "PIN: change it"
msgstr "PIN: zmeniť"

#: area_guard.py:628
msgid "Your PIN must be changed now."
msgstr "PIN si musíš zmeniť hneď."

#: area_guard.py:632
#, python-format
msgid "PIN: %(d)d d %(h)d h"
msgstr "PIN: %(d)d d %(h)d h"

#: area_guard.py:633
#, python-format
msgid ""
"Your PIN expires on %(time)s – change it under My access > Change my PIN."
msgstr "Tvoj PIN vyprší %(time)s – zmeníš ho v Môj prístup > Zmeniť môj PIN."

#: area_guard.py:638
#, python-format
msgid "Account until %(time)s"
msgstr "Účet do %(time)s"

#: area_guard.py:639
#, python-format
msgid "Your account is switched off on %(time)s."
msgstr "Tvoj účet bude vypnutý %(time)s."

#: area_guard.py:642
#, python-format
msgid "Working time over: signed out in %(m)d min"
msgstr "Koniec pracovnej doby: odhlásenie o %(m)d min"

#: area_guard.py:643
#, python-format
msgid ""
"The working time is over. You have one more save; after it, or after %(m)d "
"minutes, you are signed out."
msgstr ""
"Pracovná doba skončila. Máš ešte jedno uloženie; po ňom, alebo po %(m)d "
"minútach, ťa odhlásime."

#: area_views.py:34
msgid ""
"You do not administer any protected area. Here is what you are allowed."
msgstr "Nespravujete žiadnu chránenú oblasť. Tu je to, čo máte povolené."

#: area_views.py:48
#, python-format
msgid "%(app)s (everything)"
msgstr "%(app)s (všetko)"

#: area_views.py:58
msgid "Everything in this area"
msgstr "Všetko v tejto oblasti"

#: area_views.py:139
msgid "Protecting"
msgstr "Chráni"

#: area_views.py:141
msgid "Off (the plugin integration is not switched on)"
msgstr "Vypnuté (integrácia pluginu nie je zapnutá)"

#: area_views.py:143
msgid "Off (deactivated by the owners)"
msgstr "Vypnuté (vlastníci ju deaktivovali)"

#: area_views.py:144
msgid "Off (\"Protect areas and objects\" is not switched on in the settings)"
msgstr "Vypnuté („Chrániť oblasti a objekty“ nie je v nastaveniach zapnuté)"

#: area_views.py:197 guest_views.py:322
msgid "Write the end as a date and a time."
msgstr "Zadaj koniec ako dátum a čas."

#: area_views.py:202
#, python-format
msgid "The exception is set: %(user)s works with the permissions of NetBox."
msgstr "Výnimka je nastavená: %(user)s pracuje s právami z NetBoxu."

#: area_views.py:205
#, python-format
msgid ""
"%(user)s is in groups (%(groups)s): they do not apply to him while the "
"exception lasts."
msgstr ""
"%(user)s je v skupinách (%(groups)s): kým trvá výnimka, neplatia pre neho."

#: area_views.py:212
msgid "The exception was taken away: the protection applies to him again."
msgstr "Výnimka bola odobratá: ochrana sa naňho vzťahuje znova."

#: area_views.py:218 area_views.py:352 area_views.py:413 area_views.py:446
#: area_views.py:544 area_views.py:797 area_views.py:817 guest_views.py:412
#: guest_views.py:475 guest_views.py:480 guest_views.py:485 guest_views.py:489
msgid "Saved."
msgstr "Uložené."

#: area_views.py:229
#, python-brace-format
msgid ""
"Area \"{name}\" created. Appoint its owners now - until then only the master"
" has access to it."
msgstr ""
"Oblasť „{name}“ bola vytvorená. Teraz vymenujte jej vlastníkov – dovtedy do "
"nej má prístup len master."

#: area_views.py:235
msgid "The protection was removed."
msgstr "Ochrana bola odstránená."

#: area_views.py:242
msgid "Choose an app or an object type."
msgstr "Vyber aplikáciu alebo typ objektu."

#: area_views.py:250 areas.py:1333
msgid "Unknown object type."
msgstr "Neznámy typ objektu."

#: area_views.py:255
#, python-brace-format
msgid ""
"\"{name}\" is protected now. Appoint its owners; until then only the "
"protection keepers see it."
msgstr ""
"„{name}“ je teraz chránené. Určte vlastníkov; dovtedy to vidia len "
"správcovia ochrany."

#: area_views.py:262
msgid "Protection keeper appointed."
msgstr "Správca ochrany vymenovaný."

#: area_views.py:266
msgid "Protection keeper removed."
msgstr "Správca ochrany odobraný."

#: area_views.py:269
msgid "Everything not allowed is now denied."
msgstr "Všetko, čo nie je povolené, je teraz zakázané."

#: area_views.py:270
msgid "\"Deny everything not allowed\" is switched off."
msgstr "„Zakázať všetko, čo nie je povolené“ je vypnuté."

#: area_views.py:355
msgid "Area deleted."
msgstr "Oblasť zmazaná."

#: area_views.py:361
msgid "Object type added."
msgstr "Typ objektu pridaný."

#: area_views.py:363
msgid "Choose an object type."
msgstr "Vyberte typ objektu."

#: area_views.py:366
msgid "Object type removed."
msgstr "Typ objektu odobraný."

#: area_views.py:370 area_views.py:422 area_views.py:807
msgid "Choose a user."
msgstr "Vyber používateľa."

#: area_views.py:375
#, python-brace-format
msgid "Owner added: {name}"
msgstr "Vlastník pridaný: {name}"

#: area_views.py:381
#| msgid "The condition was added."
msgid "The section was changed."
msgstr "Úsek bol zmenený."

#: area_views.py:385
msgid "Owner removed."
msgstr "Vlastník odobraný."

#: area_views.py:393
msgid "Profile saved."
msgstr "Profil uložený."

#: area_views.py:397
msgid "Profile deleted."
msgstr "Profil zmazaný."

#: area_views.py:404
msgid "Group created. Set what it may do and add its users."
msgstr "Skupina vytvorená. Nastav, čo smie, a pridaj jej používateľov."

#: area_views.py:417 area_views.py:843
msgid "Group deleted."
msgstr "Skupina zmazaná."

#: area_views.py:426 area_views.py:811
#, python-format
msgid ""
"%(user)s has an exception: the group does not apply to him while the "
"exception lasts."
msgstr "%(user)s má výnimku: kým trvá, skupina pre neho neplatí."

#: area_views.py:429 area_views.py:814
msgid "Added to the group."
msgstr "Pridaný do skupiny."

#: area_views.py:437 area_views.py:464 area_views.py:663
msgid "Access granted."
msgstr "Prístup udelený."

#: area_views.py:442
msgid "The rights or the rows are not valid."
msgstr "Práva alebo riadky nie sú platné."

#: area_views.py:450
msgid "Access revoked."
msgstr "Prístup odobraný."

#: area_views.py:455 area_views.py:643
msgid "Request denied."
msgstr "Žiadosť zamietnutá."

#: area_views.py:459
msgid "Choose the rights and the duration."
msgstr "Vyber práva a trvanie."

#: area_views.py:555 area_views.py:803
#, python-brace-format
msgid "Saved ({n} changes)."
msgstr "Uložené ({n} zmien)."

#: area_views.py:569 areas.py:1346
msgid "Write why you need the access (at least a few words)."
msgstr "Napíšte, prečo prístup potrebujete (aspoň pár slov)."

#: area_views.py:574
#, python-brace-format
msgid ""
"The owners of \"{area}\" were asked for access. You will get an e-mail when "
"they decide."
msgstr ""
"Vlastníci oblasti „{area}“ boli požiadaní o prístup. Keď rozhodnú, dostanete"
" e-mail."

#: area_views.py:587
msgid ""
"Choose the rights and write why you need the access (at least a few words)."
msgstr "Vyber práva a napíš, prečo prístup potrebuješ (aspoň pár slov)."

#: area_views.py:592 area_views.py:659 areas.py:1239 areas.py:1487
#: areas.py:1509 areas.py:1578 forms.py:535 forms.py:565
msgid "Choose at least one right."
msgstr "Vyberte aspoň jedno právo."

#: area_views.py:595
msgid "The request was sent. You will get an e-mail when it is decided."
msgstr "Žiadosť bola odoslaná. Keď sa rozhodne, dostaneš e-mail."

#: area_views.py:825
msgid "The condition was added."
msgstr "Podmienka bola pridaná."

#: area_views.py:827
msgid ""
"Mind that a record which does not meet the conditions disappears for the "
"group right after it is saved."
msgstr ""
"Pozor: záznam, ktorý nespĺňa podmienky, skupine hneď po uložení zmizne."

#: area_views.py:836
msgid "The condition was removed."
msgstr "Podmienka bola odstránená."

#: area_views.py:840
msgid "Removed from the group."
msgstr "Odobraný zo skupiny."

#: areas.py:215
msgid "Fill in the first part before the second one."
msgstr "Najprv vyplň prvú časť, až potom druhú."

#: areas.py:221
msgid ""
"Each part: 2 to 49 letters, digits or dashes; at most two parts (e.g. "
"aqer/x2); the first part not a name NetBox uses (api, admin, login ...)."
msgstr ""
"Každá časť: 2 až 49 písmen, číslic alebo pomlčiek; najviac dve časti (napr. "
"aqer/x2); prvá časť nesmie byť názov, ktorý používa NetBox (api, admin, "
"login …)."

#: areas.py:329
msgid "View"
msgstr "Zobraziť"

#: areas.py:329 templates/netbox_user_pin/areas.html:115
#: templates/netbox_user_pin/guest_home.html:22
#: templates/netbox_user_pin/inc/group_fields.html:46
#: templates/netbox_user_pin/inc/group_rule_form.html:10
#: templates/netbox_user_pin/mail.html:89
msgid "Add"
msgstr "Pridať"

#: areas.py:329 templates/netbox_user_pin/approval_list.html:11
#: templates/netbox_user_pin/approval_list.html:31
msgid "Change"
msgstr "Zmena"

#: areas.py:329 templates/netbox_user_pin/areas.html:103
#: templates/netbox_user_pin/guest_list.html:48
msgid "Delete"
msgstr "Zmazať"

#: areas.py:330
msgid "Import"
msgstr "Import"

#: areas.py:330
msgid "Export"
msgstr "Export"

#: areas.py:542 areas.py:1513
msgid "Revoke this access and grant it again."
msgstr "Zruš tento prístup a udeľ ho znova."

#: areas.py:608 fieldrules.py:153 fieldrules.py:287
#: templates/netbox_user_pin/inc/group_script.html:34
msgid "is"
msgstr "je"

#: areas.py:608
msgid "is not"
msgstr "nie je"

#: areas.py:608 fieldrules.py:153 fieldrules.py:287
#: templates/netbox_user_pin/inc/group_fields.html:40
#: templates/netbox_user_pin/inc/group_script.html:34
msgid "contains"
msgstr "obsahuje"

#: areas.py:608
msgid "does not contain"
msgstr "neobsahuje"

#: areas.py:609 fieldrules.py:153 fieldrules.py:287
#: templates/netbox_user_pin/inc/group_fields.html:41
#: templates/netbox_user_pin/inc/group_script.html:34
msgid "starts with"
msgstr "začína na"

#: areas.py:609 templates/netbox_user_pin/inc/group_fields.html:42
msgid "is one of"
msgstr "je jedno z"

#: areas.py:609
msgid "is not one of"
msgstr "nie je jedno z"

#: areas.py:666
msgid "yes"
msgstr "áno"

#: areas.py:666
msgid "no"
msgstr "nie"

#: areas.py:679
msgid "Choose the field and the condition."
msgstr "Vyber pole a podmienku."

#: areas.py:682
msgid "Write or choose the value."
msgstr "Napíš alebo vyber hodnotu."

#: areas.py:706
msgid "This field cannot be compared by a text."
msgstr "Toto pole sa nedá porovnať textom."

#: areas.py:721
#, python-format
msgid "The condition is not valid: %(error)s"
msgstr "Podmienka nie je platná: %(error)s"

#: areas.py:748
msgid "Unknown choice."
msgstr "Neznáma voľba."

#: areas.py:789
#, python-format
msgid ""
"\"%(value)s\" is already in the list of %(list)s: a value cannot be both "
"allowed and denied."
msgstr ""
"„%(value)s“ je už v zozname %(list)s: hodnota nemôže byť zároveň povolená aj"
" zakázaná."

#: areas.py:790 templates/netbox_user_pin/user_list.html:79
msgid "allowed"
msgstr "povolený"

#: areas.py:790 templates/netbox_user_pin/user_list.html:79
msgid "denied"
msgstr "zakázaný"

#: areas.py:880
msgid ""
"Use \"app.model: lookup=value\", e.g. dcim.device: "
"name__istartswith=PRINTER."
msgstr ""
"Použite „app.model: lookup=hodnota“, napr. dcim.device: "
"name__istartswith=PRINTER."

#: areas.py:883 areas.py:1110 areas.py:1490 areas.py:1590 areas.py:1922
#, python-format
msgid "\"%(target)s\" is not protected by this area."
msgstr "„%(target)s“ táto oblasť nechráni."

#: areas.py:888
msgid "Use lookup=value, e.g. name__istartswith=PRINTER."
msgstr "Použite lookup=hodnota, napr. name__istartswith=PRINTER."

#: areas.py:893
#, python-format
msgid "The filter for \"%(target)s\" is not valid: %(error)s"
msgstr "Filter pre „%(target)s“ nie je platný: %(error)s"

#: areas.py:916
#, python-format
msgid "%(user)s is not permitted to use a PIN (denied by an administrator)."
msgstr "%(user)s nesmie používať PIN (zakázal to administrátor)."

#: areas.py:1042
#, python-format
msgid "\"%(target)s\" cannot be protected."
msgstr "„%(target)s“ sa nedá chrániť."

#: areas.py:1048
#, python-format
msgid ""
"\"%(target)s\" is not an installed app or object type (use app or app.model,"
" e.g. dcim or users.user)."
msgstr ""
"„%(target)s“ nie je nainštalovaná aplikácia ani typ objektu (použite app "
"alebo app.model, napr. dcim alebo users.user)."

#: areas.py:1052
msgid "Enter at least one app or object type."
msgstr "Zadajte aspoň jednu aplikáciu alebo typ objektu."

#: areas.py:1085
msgid "Is not a superuser or a protection keeper"
msgstr "Nie je superuser ani správca ochrany"

#: areas.py:1086
msgid "Is a superuser or a protection keeper (they are decided about)"
msgstr "Je superuser alebo správca ochrany (o tých sa rozhoduje)"

#: areas.py:1087
#| msgid "A PIN was set for your NetBox account."
msgid "Is a NetBox account"
msgstr "Je NetBox účet"

#: areas.py:1087
#| msgid "PIN-only access"
msgid "Is a PIN-only access"
msgstr "Je prístup len cez PIN"

#: areas.py:1089
msgid "Has a PIN"
msgstr "Má PIN"

#: areas.py:1089
msgid "Has no PIN yet"
msgstr "Zatiaľ nemá PIN"

#: areas.py:1090
msgid "Has 2FA"
msgstr "Má 2FA"

#: areas.py:1090
msgid "Has no 2FA yet"
msgstr "Zatiaľ nemá 2FA"

#: areas.py:1098
#, python-format
#| msgid "%(user)s cannot own an area: %(why)s."
msgid "%(user)s cannot manage a section: %(why)s."
msgstr "%(user)s nemôže spravovať úsek: %(why)s."

#: areas.py:1116
#| msgid "Delete the area"
msgid "the whole area"
msgstr "celá oblasť"

#: areas.py:1125
#, python-format
#| msgid "You are an owner of the area \"%(area)s\""
msgid "You manage a section of the area \"%(area)s\""
msgstr "Spravuješ úsek oblasti „%(area)s“"

#: areas.py:1126
#, python-format
#| msgid ""
#| "You were appointed an owner of the protected area \"%(area)s\". You decide "
#| "who gets access to it: requests arrive here (bell and e-mail) and are "
#| "confirmed with your PIN and 2FA."
msgid ""
"You were appointed the manager of a section of the protected area "
"\"%(area)s\": %(scope)s. You decide who gets access to it and what the "
"groups and fields allow there; requests arrive here (bell and e-mail) and "
"are confirmed with your PIN and 2FA."
msgstr ""
"Bol si určený za správcu úseku chránenej oblasti „%(area)s“: %(scope)s. "
"Rozhoduješ, kto k nemu dostane prístup a čo tam skupiny a polia dovoľujú; "
"žiadosti prídu sem (zvonček a e-mail) a potvrdzuješ ich svojím PIN-om a 2FA."

#: areas.py:1141
msgid "An access with a PIN only cannot be given this duty."
msgstr "Prístup len cez PIN nemôže dostať túto funkciu."

#: areas.py:1149 areas.py:1165 areas.py:1730 areas.py:1789
msgid "The account is not active."
msgstr "Účet nie je aktívny."

#: areas.py:1189
msgid "The last owner cannot be removed. Appoint another owner first."
msgstr ""
"Posledného vlastníka nemožno odobrať. Najprv vymenujte iného vlastníka."

#: areas.py:1208
msgid ""
"Some object type is sensitive or protected by another area: only a "
"protection keeper can put it in this one."
msgstr ""
"Niektorý typ objektu je citlivý alebo ho chráni iná oblasť: do tejto ho môže"
" pridať iba ochranca."

#: areas.py:1225
msgid ""
"The area of a plugin cannot be deleted; switch the plugin integration off."
msgstr "Oblasť pluginu sa nedá zmazať; vypnite integráciu pluginu."

#: areas.py:1243
msgid "A profile with this name exists."
msgstr "Profil s týmto názvom už existuje."

#: areas.py:1259
msgid "The profile is in use. Revoke those grants first."
msgstr "Profil sa používa. Najprv odoberte tieto prístupy."

#: areas.py:1350
msgid ""
"Nobody can decide about it yet. Ask the administrator to appoint the owners "
"or a protection keeper."
msgstr ""
"Zatiaľ o tom nemá kto rozhodnúť. Požiadaj administrátora, aby určil "
"vlastníkov alebo správcu ochrany."

#: areas.py:1363
#, python-format
msgid ""
"%(user)s asks for access: %(what)s\n"
"\n"
"Rights: %(rights)s\n"
"Why: %(reason)s\n"
"What exactly: %(scope)s\n"
"\n"
"Decide here (confirm with your PIN and 2FA):\n"
"%(link)s"
msgstr ""
"%(user)s žiada o prístup: %(what)s\n"
"\n"
"Práva: %(rights)s\n"
"Prečo: %(reason)s\n"
"Čo presne: %(scope)s\n"
"\n"
"Rozhodni tu (potvrď PINom a 2FA):\n"
"%(link)s"

#: areas.py:1367
msgid "User PIN > Protected areas"
msgstr "User PIN > Chránené oblasti"

#: areas.py:1368
#, python-format
msgid "Access request: %(area)s"
